import numpy as np
import matplotlib.pyplot as plt
from scipy.spatial import distance

# ==========================================
# A2: Label Encoding and One-Hot Encoding
# ==========================================
def label_encode(feature_list):
    """Encodes categorical features into numeric labels."""
    unique_elements = list(set(feature_list))
    encoding_map = {val: idx for idx, val in enumerate(unique_elements)}
    encoded_list = [encoding_map[val] for val in feature_list]
    return encoded_list, encoding_map

def one_hot_encode(feature_list):
    """Encodes categorical features into a One-Hot matrix."""
    unique_elements = list(set(feature_list))
    encoding_map = {val: idx for idx, val in enumerate(unique_elements)}
    one_hot_matrix = []
    for val in feature_list:
        row = [0] * len(unique_elements)
        row[encoding_map[val]] = 1
        one_hot_matrix.append(row)
    return one_hot_matrix, encoding_map

# ==========================================
# A4: Generalized Minkowski Distance
# ==========================================
def calculate_minkowski_distance(vec1, vec2, p):
    """Calculates Minkowski distance for order parameter p."""
    if len(vec1) != len(vec2):
        raise ValueError("Vectors must be of the same length.")
    distance_val = sum(abs(a - b) ** p for a, b in zip(vec1, vec2)) ** (1 / p)
    return distance_val

# ==========================================
# A7: Vector Dot Product and Euclidean Norm
# ==========================================
def calculate_dot_product(vec1, vec2):
    """Calculates the dot product of two N-dimensional vectors."""
    if len(vec1) != len(vec2):
        raise ValueError("Vectors must be of the same length.")
    return sum(a * b for a, b in zip(vec1, vec2))

def calculate_euclidean_norm(vec):
    """Calculates the Euclidean norm (length) of a vector."""
    return sum(x ** 2 for x in vec) ** 0.5

# ==========================================
# A8: Mean, Variance, and Standard Deviation
# ==========================================
def calculate_mean(data_matrix, axis=0):
    """Calculates the mean for a matrix along a given axis."""
    matrix = np.array(data_matrix)
    if axis == 0:
        cols = matrix.shape[1]
        rows = matrix.shape[0]
        mean_vec = [sum(matrix[:, c]) / rows for c in range(cols)]
        return np.array(mean_vec)
    return None

def calculate_variance(data_matrix, axis=0):
    """Calculates the variance for a matrix along a given axis."""
    matrix = np.array(data_matrix)
    mean_vec = calculate_mean(matrix, axis)
    if axis == 0:
        cols = matrix.shape[1]
        rows = matrix.shape[0]
        var_vec = [sum((matrix[:, c] - mean_vec[c]) ** 2) / rows for c in range(cols)]
        return np.array(var_vec)
    return None

def calculate_std(data_matrix, axis=0):
    """Calculates the standard deviation for a matrix along a given axis."""
    var_vec = calculate_variance(data_matrix, axis)
    return np.array([v ** 0.5 for v in var_vec])

# ==========================================
# A11: K-means Algorithm
# ==========================================
def k_means_clustering(data, k, max_iters=100, p=2):
    """Implements basic K-means clustering algorithm."""
    data = np.array(data)

    # Step 1: Select K points as initial centroids
    np.random.seed(42)
    random_indices = np.random.choice(len(data), size=k, replace=False)
    centroids = data[random_indices]

    for _ in range(max_iters):
        # Step 3: Form K clusters by assigning each point to its closest centroid
        clusters = [[] for _ in range(k)]
        for point in data:
            distances = [calculate_minkowski_distance(point, c, p) for c in centroids]
            closest_idx = np.argmin(distances)
            clusters[closest_idx].append(point)

        # Step 4: Recompute the centroid of each cluster
        new_centroids = []
        for cluster in clusters:
            if not cluster:
                # Handle edge case for empty clusters to prevent division by zero
                new_centroids.append(data[np.random.choice(len(data))])
            else:
                new_centroids.append(calculate_mean(cluster, axis=0))

        new_centroids = np.array(new_centroids)

        # Step 5: Stop condition - centroids do not change
        if np.allclose(centroids, new_centroids):
            break
        centroids = new_centroids

    return centroids, clusters


