def calculate_minkowski_distance_manual(vec1, vec2, p):
    """Calculates Minkowski distance using standard Python (Lab 03)."""
    if len(vec1) != len(vec2):
        raise ValueError("Vectors must be of the same length.")
    return sum(abs(a - b) ** p for a, b in zip(vec1, vec2)) ** (1 / p)

def calculate_mean_manual(data_matrix, axis=0):
    """Calculates the mean for a matrix along a given axis (Lab 03)."""
    matrix = np.array(data_matrix)
    if axis == 0:
        cols = matrix.shape[1]
        rows = matrix.shape[0]
        mean_vec = [sum(matrix[:, c]) / rows for c in range(cols)]
        return np.array(mean_vec)
    return None

def k_means_clustering_manual(data, k, max_iters=100, p=2):
    """Implements K-means clustering algorithm manually (Lab 03)."""
    data = np.array(data)
    np.random.seed(42)

    random_indices = np.random.choice(len(data), size=k, replace=False)
    centroids = data[random_indices]

    for _ in range(max_iters):
        clusters = [[] for _ in range(k)]
        for point in data:
            distances = [calculate_minkowski_distance_manual(point, c, p) for c in centroids]
            closest_idx = np.argmin(distances)
            clusters[closest_idx].append(point)

        new_centroids = []
        for cluster in clusters:
            if not cluster:
                new_centroids.append(data[np.random.choice(len(data))])
            else:
                new_centroids.append(calculate_mean_manual(cluster, axis=0))

        new_centroids = np.array(new_centroids)

        if np.allclose(centroids, new_centroids):
            break
        centroids = new_centroids

    return centroids, clusters

