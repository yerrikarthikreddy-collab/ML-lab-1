class TestLabFunctions(unittest.TestCase):

    def test_minkowski_distance_manual(self):
        vec1 = [1, 2, 3]
        vec2 = [4, 5, 6]
        dist = calculate_minkowski_distance_manual(vec1, vec2, p=2)
        expected_dist = np.linalg.norm(np.array(vec1) - np.array(vec2))
        self.assertAlmostEqual(dist, expected_dist, places=4)

    def test_minkowski_distance_ai(self):
        vec1 = [1, 2, 3]
        vec2 = [4, 5, 6]
        dist = calculate_minkowski_distance_ai(vec1, vec2, p=2)
        expected_dist = np.linalg.norm(np.array(vec1) - np.array(vec2))
        self.assertAlmostEqual(dist, expected_dist, places=4)

    def test_k_means_clustering(self):
        # Simple dataset test for both algorithms
        data = np.array([[1, 1], [1.5, 1.5], [8, 8], [8.5, 8.5]])

        centroids_manual, _ = k_means_clustering_manual(data, k=2)
        centroids_ai, _ = k_means_clustering_ai(data, k=2)

        self.assertEqual(len(centroids_manual), 2)
        self.assertEqual(len(centroids_ai), 2)

