def calculate_minkowski_distance_ai(vec1, vec2, p):
    """Calculates Minkowski distance using numpy for vectorization."""
    vec1, vec2 = np.array(vec1), np.array(vec2)
    return np.sum(np.abs(vec1 - vec2) ** p) ** (1 / p)

def k_means_clustering_ai(data, k, max_iters=100, p=2):
    """Optimized K-means clustering algorithm using NumPy vectorization."""
    data = np.array(data)
    np.random.seed(42)

    random_indices = np.random.choice(data.shape[0], size=k, replace=False)
    centroids = data[random_indices]

    for _ in range(max_iters):
        # Calculate distances from all points to all centroids
        distances = np.array([[calculate_minkowski_distance_ai(point, c, p) for c in centroids] for point in data])

        # Assign points to the closest centroid
        cluster_assignments = np.argmin(distances, axis=1)

        # Recompute centroids using vectorized mean
        new_centroids = np.array([data[cluster_assignments == i].mean(axis=0) if np.any(cluster_assignments == i)
                                  else data[np.random.choice(data.shape[0])] for i in range(k)])

        if np.allclose(centroids, new_centroids):
            break
        centroids = new_centroids

    return centroids, cluster_assignments

